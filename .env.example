VITE_API_BASE_URL=http://localhost:8080

# Feature flags (default false). Once shipped as true, don't flip back.
# Multiple ACTIVE investment tranches per member (top-up entry point, tranche list).
VITE_MULTI_INVESTMENT_ENABLED=false
# Partial principal withdrawal amount input, per-tranche remaining principal.
VITE_PARTIAL_PRINCIPAL_WITHDRAWAL_ENABLED=false
